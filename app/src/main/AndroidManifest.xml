<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed on Android 11+ to see the full installed-apps list -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Needed by the virtual engine to read/copy target APKs off disk -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Cloner"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:extractNativeLibs="true"
        android:theme="@style/Theme.DualApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Cloner"
            android:theme="@style/Theme.DualApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Proxy activities: the virtual engine launches a cloned app's real
          Activity *as if* it were one of these stub activities, so the
          system only ever sees activities that are actually declared here.
          Phase 2 will register several of these (different launch modes /
          task affinities) as the hooking layer is built out.
        -->
        <activity
            android:name=".virtual.VirtualStubActivity"
            android:exported="false"
            android:theme="@style/Theme.DualApp" />

    </application>

</manifest>
